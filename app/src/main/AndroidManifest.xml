<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Background listening runs in a mediaPlayback foreground service (ADR 0003, ADR 0014). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Text recognition of scanned books runs in a dataSync foreground service (ADR 0015). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Lets that service show its progress on Android 13+ once notifications are allowed. Never requested: the
        library shows the progress, and the work goes on without the notification (ADR 0015).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the CPU awake while reading with the screen off (ExoPlayer wake mode). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        ML Kit's usage logging (Firebase datatransport) asks for the network. The app has no network access:
        no telemetry, and nothing leaves the phone without a user action (ADR 0012, ADR 0015).
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!--
        Cloud backup is excluded entirely (data_extraction_rules / backup_rules);
        device-to-device transfer stays allowed. See ADR 0012.
    -->
    <application
        android:name=".RReaderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RReader">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a book from another app. octet-stream covers apps that send EPUBs
                 without a specific type; content is verified by signature on intake (SR-7). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Open with" a book from a file manager or another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            Media3 requires the session service to be exported so the system (notification, lock screen,
            Bluetooth) can bind to it; the session only accepts trusted controllers (SR-7).
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- WorkManager is initialised on demand with Hilt's worker factory (RReaderApplication). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager's foreground service runs long imports (text recognition) as dataSync work (ADR 0015). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            Unregisters the only datatransport backend, which uploads ML Kit's usage logs, so they are dropped
            instead of being queued on the phone (ADR 0012, ADR 0015).
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

</manifest>
