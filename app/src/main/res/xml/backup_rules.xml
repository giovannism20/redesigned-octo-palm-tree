<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older cannot separate cloud backup from device transfer, so
    everything is excluded there to keep data off the cloud.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
