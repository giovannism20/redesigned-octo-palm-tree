<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RReader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: the logo on the brand's night blue, then Theme.RReader. -->
    <style name="Theme.RReader.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RReader</item>
    </style>
</resources>
